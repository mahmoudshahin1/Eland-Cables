  materialNumber          String?
  itemDescription         String
  quantity                Decimal             @default(1)
  quantityUom             String              @default("KM")
  lengthMeters            Decimal             @default(1000)

  // Snapshot fields for SO / agreement copy (Spec §5.2 / §13) — copied scalars; no costing recompute
  customerCableCode       String?
  configurationId         String?
  engineeringRevision     String?
  bomVersion              String?
  technicalSpecificationId String?
  cuttingLengthMeters     Decimal?
  numberOfCuts            Int?
  drumType                String?
  drumSize                String?
  drumQuantity            Decimal?
  drumLengthMeters        Decimal?
  drumWeightKg            Decimal?

  // Governed Costing Link
  costingRunId            String?
  costingCalculationId    String?
  costingCalculation      CostingCalculation? @relation(fields: [costingCalculationId], references: [id], onDelete: SetNull)
  materialCost            Decimal?
  materialCostCurrency    String?             @default("USD")

