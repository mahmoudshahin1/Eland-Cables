  commercialStatus        String              @default("MATERIAL_COST_AVAILABLE")
  sellingPrice            Decimal?
  pricingSnapshotId       String?
  pricingSnapshot         CommercialPricingSnapshot?
  notes                   String?

  /// V2 lineage pins (Task 05F)
  workflowChannel              String?
  v2ConfigurationSnapshotId    String?
  v2ConfigurationSnapshotIdString String?
  v2CuttingLengthPlanId        String?
  v2CuttingLengthPlanIdString  String?
  v2DrumPlanId                 String?
  v2DrumPlanVersionNo          Int?
  v2DrumPlanIdString           String?
  plannedLengthM               Decimal?
  drumCount                    Int?
  technicalOfferAttachmentIds  Json?
  technicalSummarySnapshot     Json?
  drumPlanLinesSnapshot        Json?
  lineageSnapshot              Json?

  createdAt               DateTime            @default(now())

  @@index([quotationId])
  @@index([v2DrumPlanId])
}

/// Bridge between approved quotation revision and fulfillment (Spec §10–11). One quotation → many SOs / one agreement.
model CommercialCommitment {
  id                       String                     @id @default(cuid())
  commitmentNumber         String                     @unique
  quotationId              String
  quotation                CommercialQuotation        @relation(fields: [quotationId], references: [id])
  quotationNumber          String
  quotationVersionNo       Int
  /// V2 inquiry lineage pin (Task 05H)
  inquiryId                String?
  workflowChannel          String?
  customerId               String
  customerMasterId         String?
  customerName             String
  fulfillmentType          FulfillmentType
  currency                 String                     @default("USD")
  totalCommittedQuantity   Decimal
  totalCommittedAmount     Decimal?
  quantityUom              String                     @default("KM")
  orderedQuantity          Decimal                    @default(0)
  remainingQuantity        Decimal
  effectiveDate            DateTime                   @default(now())
  expirationDate           DateTime?
  status                   CommercialCommitmentStatus @default(ACTIVE)
  d365DocumentNumber       String?
  d365RecordId             String?
  createdBy                String?
  approvedAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  salesOrders              EpcSalesOrder[]
  salesAgreements          SalesAgreement[]

  @@index([quotationId])
  @@index([inquiryId])
  @@index([customerId])
  @@index([customerMasterId])
  @@index([status])
  @@index([fulfillmentType])
}

model EpcSalesOrder {
  id                      String              @id @default(cuid())
  salesOrderNumber        String              @unique
  /// Null for DIRECT_MTS — Commercial Commitment is not required on that path.
  commitmentId            String?
  commitment              CommercialCommitment? @relation(fields: [commitmentId], references: [id])
  /// Null for DIRECT_MTS unless explicitly linked later.
  quotationId             String?
  quotation               CommercialQuotation? @relation(fields: [quotationId], references: [id])
  inquiryId               String?
  agreementReleaseId      String?             @unique
  agreementRelease        AgreementRelease?   @relation(fields: [agreementReleaseId], references: [id], onDelete: SetNull)
  /// Entry point: QUOTATION | AGREEMENT_RELEASE | DIRECT_MTS (not the same as fulfillment mode).
  orderOrigin             SalesOrderOrigin
  /// MTO vs MTS stock/manufacturing path (not the same as order origin).
  orderFulfillmentMode    OrderFulfillmentMode
  customerId              String
  customerMasterId        String?
  customerName            String
  customerReference       String?
  currency                String              @default("USD")
  paymentTerms            String?
  deliveryTerms           String?
  incoterms               String?
  billTo                  String?
  shipTo                  String?
  requestedDeliveryDate   DateTime?
  status                  EpcSalesOrderStatus @default(CONFIRMED)
  integrationStatus       EpcIntegrationStatus @default(NOT_SENT)
  d365SalesOrderNumber    String?
  d365Company             String?
  d365RecordId            String?
  /// Client-supplied key for duplicate Direct MTS create requests.
  idempotencyKey          String?             @unique
  createdBy               String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  lines                   EpcSalesOrderLine[]
  serviceCases            CustomerServiceCase[]

  @@index([commitmentId])
  @@index([quotationId])
  @@index([customerId])
  @@index([customerMasterId])
  @@index([status])
  @@index([integrationStatus])
  @@index([orderOrigin])
  @@index([orderFulfillmentMode])
}

model EpcSalesOrderLine {
