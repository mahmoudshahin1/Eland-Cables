  emptyDrumNetWeightKg     Decimal?
  grossLoadedDrumWeightKg  Decimal?
  lengthUtilizationPercent Decimal?
  loadUtilizationPercent   Decimal?
  validationStatus         String?
  validationReasons        Json?
  engineering              Json?

  @@index([drumPlanId])
  @@index([drumPlanId, lineNo])
  @@index([drumCode])
  @@index([cuttingLengthRequirementId])
}

model CommercialQuotation {
  id                      String            @id @default(cuid())
  quotationNumber         String
  inquiryId               String
  inquiry                 CommercialInquiry @relation(fields: [inquiryId], references: [id])
  customerId              String
  customerName            String
  contactPerson           String?
  versionNo               Int               @default(1)
  isCurrent               Boolean           @default(true)
  supersedesQuotationId   String?

  status                  QuotationStatus   @default(DRAFT)
  currency                String            @default("USD")
  incoterms               String?           @default("FOB")
  paymentTerms            String?           @default("LC at sight")
  deliveryTerms           String?           @default("CIF Alexandria")
  validUntil              DateTime?
  billTo                  String?
  shipTo                  String?
  requestedDeliveryDate   DateTime?

  // Commercial Boundary Notes
  materialCostTotal       Decimal           @default(0)
  commercialPricingStatus String            @default("NOT_CONFIGURED")
  sellingPrice            Decimal?

  /// Spec commercial approval — must not be conflated with commercialPricingStatus / Increment 12.
  commercialApprovalStatus CommercialApprovalStatus @default(NOT_SUBMITTED)
  fulfillmentType          FulfillmentType?
  commerciallyApprovedBy   String?
  commerciallyApprovedAt   DateTime?

  /// V2 quotation boundary (Task 05F)
  workflowChannel          String?
  issuedAt                 DateTime?
  issuedBy                 String?
  inquiryVersionNo         Int?
  inquirySnapshot          Json?
  technicalOfferStatus     String                   @default("NOT_READY")
  commercialOfferStatus    String                   @default("NOT_READY")
  validityDays             Int?
  supersededByQuotationId  String?
  technicalOfferSnapshot   Json?
  commercialOfferSnapshot  Json?
  quotationApprovedBy      String?
  quotationApprovedAt      DateTime?

  /// STANDARD_WORKFLOW customer decision (Accept / Reject / Clarification). Additive — does not replace commitment.
  customerDecision         String?
  customerDecisionReason   String?
  customerDecisionAt       DateTime?
  customerDecisionBy       String?
  quotationReturnedAt      DateTime?
  quotationReturnedBy      String?
  quotationReturnReason    String?

  quotationOwner          String?
  remarks                 String?
  createdBy               String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  customerMasterId        String?
  customerMaster          Customer?         @relation("QuotationCustomerMaster", fields: [customerMasterId], references: [id], onDelete: SetNull)

  lines                   CommercialQuotationLine[]
  hostedFinancialOffers   FinancialOfferSnapshot[]
  shippingCostSnapshot    ShippingCostTransactionSnapshot?
