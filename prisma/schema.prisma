  lineNumber               Int           @default(1)
  quotationLineId          String?
  materialNumber           String?
  itemCode                 String?
  itemDescription          String
  customerCableCode        String?
  quantity                 Decimal
  quantityUom              String        @default("KM")
  unitPrice                Decimal?
  discountPercent          Decimal?
  netPrice                 Decimal?
  lineAmount               Decimal?
  configurationId          String?
  engineeringRevision      String?
  bomVersion               String?
  technicalSpecificationId String?
  lengthMeters             Decimal?
  cuttingLengthMeters      Decimal?
  numberOfCuts             Int?
  drumType                 String?
  drumSize                 String?
  drumQuantity             Decimal?
  drumLengthMeters         Decimal?
  drumWeightKg             Decimal?
  /// Optional available-stock snapshot at Direct MTS create (not live inventory).
  availableStockQuantity   Decimal?
