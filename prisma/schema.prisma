generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUPERSEDED
}

enum PriceStatus {
  CONFIGURED
  PRICE_NOT_CONFIGURED
}

enum ParameterKind {
  FAMILY
  VOLTAGE
  CONDUCTOR
  INSULATION
  SCREEN
  ARMOUR
  SHEATH
  CORE_COLOUR
  STANDARD
}

enum ImportKind {
  cables
  boms
  drums
  raw_materials
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  REJECTED
}

model CableParameter {
  id     String        @id @default(cuid())
  kind   ParameterKind
  code   String
  name   String
  status RecordStatus  @default(ACTIVE)

  @@unique([kind, code])
}

model CableMaster {
  id               String       @id @default(cuid())
  materialNumber   String       @unique
  itemCode         String
  customerCode     String
  elandItemNumber  String?
  description      String
  family           String?
  voltage          String?
  conductor        String?
  conductorSize    String?
  cores            String?
  insulation       String?
  screen           String?
  armour           String?
  sheath           String?
  sheathColour     String?
  coreColour       String?
  standard         String?
  specialAdditives String?
  diameter         Decimal
  weight           Decimal
  uom              String       @default("CONFIGURATION_REQUIRED")
  status           RecordStatus @default(ACTIVE)
  approvalStatus   String       @default("IMPORTED")
  /// Cable stock path eligibility — independent of Sales Order Origin / Order Fulfillment Mode.
  /// MTO = quotation path only; MTS / MTO_MTS = Direct MTS SO allowed.
  fulfillmentPolicy CableFulfillmentPolicy @default(MTO)
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  sourceBatch      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?
  bomLines         CableBomLine[]
  governedBomLines GovernedBomLine[]
  engineeringMappings CableEngineeringMapping[]
  costingRuns      CostingRun[]
  attachments      CableMasterAttachment[]
  serviceCases     CustomerServiceCase[]

  @@index([fulfillmentPolicy])
}

model RawMaterial {
  code        String      @id
  description String
  shortDescription String?
  category    String?
  /// MARKET_METAL_COPPER | MARKET_METAL_ALUMINIUM | STANDARD_RAW_MATERIAL
  pricingCategory String  @default("STANDARD_RAW_MATERIAL")
  /// COPPER | ALUMINIUM | NONE — explicit market-metal classification (not inferred from code)
  metalType   String      @default("NONE")
  uom         String
  supplier    String?
  currency    String?
  notes       String?
  priceStatus PriceStatus @default(PRICE_NOT_CONFIGURED)
  status      RecordStatus @default(ACTIVE)
  sourceBatch String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  prices      RawMaterialPrice[]
  bomLines    CableBomLine[]
  governedBomLines GovernedBomLine[]

  @@index([pricingCategory])
  @@index([metalType])
  @@index([status])
}

enum PriceWorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PriceBasis {
  PER_KG
  PER_TON
  PER_METER
  PER_PCS
  PER_M2
}

model RawMaterialPrice {
  id              String              @id @default(cuid())
  rawMaterialCode String
  rawMaterial     RawMaterial         @relation(fields: [rawMaterialCode], references: [code])
  /// Null means PRICE_NOT_CONFIGURED. Never persist a fake 0 for a blank Excel price.
  price           Decimal?
  currency        String?
  /// Price quantity basis for this record (KG, MT, PCS, M). Independent of BOM consumption UOM.
  uom             String?             @default("kg")
  priceDate       DateTime?
  /// Null when the source workbook has no date. Do not default to now().
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  supplier        String?
  source          String?
  priceBasis      PriceBasis          @default(PER_KG)
  workflowStatus  PriceWorkflowStatus @default(DRAFT)
  isCurrent       Boolean             @default(true)
  revision        Int                 @default(1)
  /// EFFECTIVE when source dates exist; DATA_REQUIRED otherwise. Missing price is not a row.
  temporalStatus  String              @default("DATA_REQUIRED")
  status          RecordStatus        @default(ACTIVE)
  approvedBy      String?
  approvedAt      DateTime?
  createdBy       String?
  updatedBy       String?
  comment         String?
  sourceBatch     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([rawMaterialCode])
  @@index([workflowStatus])
  @@index([effectiveFrom, effectiveTo])
}

model CableBomLine {
  id                   String       @id @default(cuid())
  cableMaterialNumber  String
  cable                CableMaster? @relation(fields: [cableMaterialNumber], references: [materialNumber])
  rawMaterialCode      String
  rawMaterial          RawMaterial? @relation(fields: [rawMaterialCode], references: [code])
  itemCode             String?
  customerCode         String?
  consumption          Decimal
  uom                  String
  scrap                Decimal?
  bomVersion           Int          @default(1)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  status               RecordStatus @default(ACTIVE)
  sourceBatch          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  /// Until the official duplicate-weight issue is resolved, uniqueness is versioned.
  /// Cable + Raw Material alone is NOT the sole uniqueness rule.
  @@unique([cableMaterialNumber, rawMaterialCode, bomVersion])
}

enum BomInvestigationStatus {
  BUSINESS_DECISION_REQUIRED
  ASSIGNED
  UNDER_REVIEW
  DECISION_REQUIRED
  RESOLVED
  APPROVED
  REJECTED
}

model BomDuplicateObservation {
  id                   String   @id @default(cuid())
  cableMaterialNumber  String
  rawMaterialCode      String
  weightA              Decimal
  weightB              Decimal
  occurrenceCount      Int
  sourceWorksheet      String?
  sourceFile           String?
  sourceRows           Json?
  classification       String   @default("BUSINESS_DECISION_REQUIRED")
  investigationStatus  BomInvestigationStatus @default(BUSINESS_DECISION_REQUIRED)
  conflictId           String?  @unique
  customerCode         String?
  cableDescription     String?
  rawMaterialDesc      String?
  uom                  String   @default("kg")
  sourceEvidence       Json?
  
  // Dimensions required based on classification
  selectedWeight       Decimal?
  governedUom          String?
  bomVersion           Int?
  plant                String?
  manufacturingRoute   String?
  machine              String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?

  // Review & Workflow Fields
  assignedTo           String?
  assignedAt           DateTime?
  reviewer             String?
  reviewDate           DateTime?
  decision             String?
  comment              String?
  approvedBy           String?
  approvedAt           DateTime?
  rejectedBy           String?
  rejectedAt           DateTime?
  sourceBatch          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  governedBomLines     GovernedBomLine[]

  @@index([cableMaterialNumber])
  @@index([rawMaterialCode])
  @@index([investigationStatus])
}

model GovernedBomLine {
  id                   String       @id @default(cuid())
  cableMaterialNumber  String
  cable                CableMaster  @relation(fields: [cableMaterialNumber], references: [materialNumber])
  rawMaterialCode      String
  rawMaterial          RawMaterial  @relation(fields: [rawMaterialCode], references: [code])
  consumption          Decimal
  uom                  String
  scrapPercentage      Decimal?
  bomVersion           Int          @default(1)
  plant                String?
  manufacturingRoute   String?
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  status               String       @default("APPROVED")
  conflictId           String?
  conflictObservation  BomDuplicateObservation? @relation(fields: [conflictId], references: [conflictId])
  decisionReference    String?
  reviewer             String?
  approvedBy           String?
  approvedAt           DateTime     @default(now())
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([cableMaterialNumber, rawMaterialCode, bomVersion])
  @@index([cableMaterialNumber])
  @@index([rawMaterialCode])
  @@index([status])
}

enum MappingWorkflowStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

model CableEngineeringMapping {
  id               String                @id @default(cuid())
  materialNumber   String
  cable            CableMaster           @relation(fields: [materialNumber], references: [materialNumber])
  revision         Int                   @default(1)
  isCurrent        Boolean               @default(true)
  status           MappingWorkflowStatus @default(DRAFT)
  mappingStatus    String                @default("PARTIAL")
  dataSource       String                @default("Energya Cable Master Data.xlsx / Cable List")
  sourceReference  String?

  // Controlled Approved Engineering Attributes (null if not yet approved/configured)
  family           String?
  voltage          String?
  conductor        String?
  conductorSize    String?
  cores            String?
  insulation       String?
  screen           String?
  armour           String?
  sheath           String?
  sheathColour     String?
  coreColour       String?
  standard         String?
  specialAdditives String?

  // Full audited JSON state including suggested derivations and attribute origins
  attributes       Json
  suggested        Json?

  // Controlled Workflow Actors & Timestamps
  createdBy        String?
  createdAt        DateTime              @default(now())
  submittedBy      String?
  submittedAt      DateTime?
  assignedReviewer String?
  reviewedBy       String?
  reviewedAt       DateTime?
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  comments         String?
  updatedAt        DateTime              @updatedAt

  @@unique([materialNumber, revision])
  @@index([materialNumber, isCurrent])
  @@index([status])
}

model DrumMaster {
  id                 String       @id @default(cuid())
  drumCode           String       @unique
  drumType           String?
  description        String?
  flange             Decimal
  barrel             Decimal
  barrelWidth        Decimal?
  innerWidth         Decimal
  outerWidth         Decimal
  usableWidth        Decimal?
  capacity           Decimal
  /// MaxLoad = permitted cable payload (kg). TO: set from Capacity when valid; empty weight excluded.
  maxWeight          Decimal?
  /// Flange clearance (mm). TO default 50 for ACTIVE; used when cable diameter ≤ 50 mm.
  clearanceMm        Decimal?
  /// Empty / tare net weight (kg) — logistics WARNING only; never blocks suitability.
  emptyDrumNetWeightKg Decimal?
  capacityUom        String       @default("CONFIGURATION_REQUIRED")
  dimensionUnitNote  String       @default("SOURCE_UNIT_NOT_IN_FILE")
  status             RecordStatus @default(ACTIVE)
  sourceBatch        String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  packingProfiles    DrumPackingProfile[]
  serviceCases       CustomerServiceCase[]
}

model DrumCompatibility {
  id           String       @id @default(cuid())
  cableFamily  String?
  voltage      String?
  minDiameter  Decimal?
  maxDiameter  Decimal?
  maxLength    Decimal?
  maxWeight    Decimal?
  customerCode String?
  drumCode     String?
  priority     Int?
  status       RecordStatus @default(ACTIVE)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
}

model ImportBatch {
  id           String       @id @default(cuid())
  batchNumber  String       @unique
  sourceFile   String
  importedBy   String
  importedDate DateTime     @default(now())
  dataType     ImportKind
  rowCount     Int
  successCount Int
  errorCount   Int
  warningCount Int
  skippedCount Int          @default(0)
  status       ImportStatus
  errorsJson   Json
  warningsJson Json
  rows         ImportBatchRow[]
}

model ImportBatchRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber Int
  severity  String
  field     String?
  code      String
  message   String
}

model AuditEvent {
  id         String   @id @default(cuid())
  at         DateTime @default(now())
  actorId    String?
  actorName  String?
  entity     String
  entityId   String
  action     String
  oldValue   Json?
  newValue   Json?
  message    String?

  @@index([entity, at])
  @@index([actorId, at])
}

enum CompatibilityRelation {
  ALLOWED
  FORBIDDEN
}

model ParameterCompatibility {
  id       String                @id @default(cuid())
  fromKind ParameterKind
  fromCode String
  toKind   ParameterKind
  toCode   String
  relation CompatibilityRelation
  source   String                @default("parameter_master_applicable_families")

  @@unique([fromKind, fromCode, toKind, toCode, relation])
}

model TechnicalOfficeRequest {
  id              String   @id @default(cuid())
  requestNumber   String   @unique
  canonicalStatus String
  displayStatus   String
  configuration   Json
  customer        String?
  quantity        String?
  cuttingLength   String?
  requestedDate   String?
  requesterId     String?
  requesterName   String?
  requesterEmail  String?
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum CostingRunStatus {
  DRAFT
  CALCULATED
  INCOMPLETE
  BLOCKED
  SUPERSEDED
}

enum CostComponentType {
  MATERIAL
  PROCESS
  LABOUR
  ENERGY
  OVERHEAD
  PACKAGING
  DRUM
  SCRAP
  OTHER
}

model CostingRun {
  id                      String           @id @default(cuid())
  costingRunNumber        String           @unique
  materialNumber          String
  cable                   CableMaster      @relation(fields: [materialNumber], references: [materialNumber])
  costingDate             DateTime
  currency                String           @default("USD")
  quantity                Decimal          @default(1)
  lengthMeters            Decimal          @default(1000)
  lengthKm                Decimal          @default(1)
  engineeringRevision     Int              @default(1)
  bomVersion              Int              @default(1)
  status                  CostingRunStatus @default(INCOMPLETE)
  /// Null = legacy Increment 10 material-only run (no published costing configuration).
  configurationVersionId  String?
  configurationVersion    CostingConfigurationVersion? @relation(fields: [configurationVersionId], references: [id], onDelete: SetNull)

  // Cost Aggregates
  materialCost        Decimal
  processCostStatus   String           @default("NOT_CONFIGURED")
  overheadCostStatus  String           @default("NOT_CONFIGURED")
  scrapCostStatus     String           @default("NOT_CONFIGURED")
  manufacturingCost   Decimal?

  // Provenance & Audit
  isCurrent           Boolean          @default(true)
  supersededById      String?
  blockingReasons     Json?
  inquiryLineId       String?
  /// V2 drum plan lineage pin (Task 05E).
  drumPlanId          String?
  drumPlan            V2DrumPlan?      @relation(fields: [drumPlanId], references: [id], onDelete: SetNull)
  /// 05I-DF-D: exact ContainerStudyResult consumed by this run. Never latest/currentResultId.
  containerStudyResultId String?
  containerStudyResult   ContainerStudyResult? @relation(fields: [containerStudyResultId], references: [id], onDelete: Restrict)
  createdBy           String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  costingLines        CostingLine[]

  @@index([materialNumber, isCurrent])
  @@index([inquiryLineId])
  @@index([costingDate])
  @@index([status])
  @@index([configurationVersionId])
  @@index([drumPlanId])
  @@index([containerStudyResultId])
}

model CostingLine {
  id                  String            @id @default(cuid())
  costingRunId        String
  costingRun          CostingRun        @relation(fields: [costingRunId], references: [id], onDelete: Cascade)
  componentType       CostComponentType @default(MATERIAL)
  rawMaterialCode     String
  rawMaterialDesc     String?

  // Quantities
  consumptionPerKm    Decimal
  totalConsumption    Decimal
  consumptionUom      String

  // Price Resolution Snapshot
  price               Decimal
  priceCurrency       String
  priceUom            String
  priceBasis          String            @default("PER_KG")
  priceRevision       Int               @default(1)
  priceId             String?
  effectiveFrom       DateTime?
  effectiveTo         DateTime?

  /// INQUIRY_HEADER | RAW_MATERIAL_MASTER
  pricingSource       String?
  masterPrice         Decimal?
  masterPriceCurrency String?
  masterPriceUom      String?
  inquiryHeaderPrice  Decimal?
  inquiryHeaderPriceUom String?

  // Calculated Cost Line
  lineCost            Decimal
  calculationNotes    String?
  createdAt           DateTime          @default(now())

  @@index([costingRunId])
  @@index([rawMaterialCode])
}

enum InquiryStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ENGINEERING_REVIEW
  ENGINEERING_BLOCKED
  READY_FOR_COMMERCIAL
  QUOTED
  CLOSED
  CANCELLED
}

enum InquiryLineStatus {
  DRAFT
  CONFIGURATION_REQUIRED
  TECHNICAL_OFFICE_REQUIRED
  CABLE_VALIDATED
  COSTING_NOT_READY
  COSTING_READY
  READY_FOR_QUOTATION
  CANCELLED
}

/// Directional cutting-length tolerance. Do not silently assume SYMMETRIC.
enum CuttingLengthToleranceMode {
  NONE
  POSITIVE
  NEGATIVE
  SYMMETRIC
}

enum QuotationStatus {
  DRAFT
  OPEN
  SUBMITTED
  ACCEPTED
  REJECTED
  SUPERSEDED
  CANCELLED
}

/// Spec §6 commercial revision approval — separate from CommercialPricingStatus (Increment 12).
enum CommercialApprovalStatus {
  NOT_SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Spec §8 / §11.2 — chosen at commercial approval; stored on quotation + commitment.
enum FulfillmentType {
  DIRECT_ORDER
  SALES_AGREEMENT
}

enum CommercialCommitmentStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

/// Short EPC-owned SO lifecycle (delivery/invoice remain D365-owned — Phase 6).
enum EpcSalesOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// How the Sales Order was created — independent of MTO/MTS fulfillment mode.
enum SalesOrderOrigin {
  QUOTATION
  AGREEMENT_RELEASE
  DIRECT_MTS
}

/// Manufacturing / stock path for the order — independent of Order Origin.
enum OrderFulfillmentMode {
  MTO
  MTS
}

/// Cable / item master eligibility for Direct MTS vs quotation-only paths.
enum CableFulfillmentPolicy {
  MTO
  MTS
  MTO_MTS
}

enum EpcIntegrationStatus {
  NOT_SENT
  PENDING
  SYNCED
  FAILED
}

enum SalesAgreementStatus {
  DRAFT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum AgreementReleaseStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model CommercialInquiry {
  id                    String            @id @default(cuid())
  inquiryNumber         String            @unique
  customerId            String
  customerName          String
  contactPerson         String?
  customerReference     String?
  inquiryDate           DateTime          @default(now())
  requestedDeliveryDate DateTime?
  currency              String            @default("USD")
  incoterms             String?           @default("FOB")
  paymentTerms          String?           @default("LC at sight")
  deliveryTerms         String?           @default("CIF Alexandria")
  projectName           String?
  status                InquiryStatus     @default(DRAFT)
  notes                 String?
  createdBy             String?
  modifiedBy            String?
  salesAgent            String?
  quotationOwner        String?
  versionNo             Int               @default(1)
  isCurrent             Boolean           @default(true)
  supersedesInquiryId   String?
  inquiryGroupKey       String?
  commercialMetadata    Json?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  customerMasterId      String?
  customerMaster        Customer?         @relation("InquiryCustomerMaster", fields: [customerMasterId], references: [id], onDelete: SetNull)

  lines                 CommercialInquiryLine[]
  quotations            CommercialQuotation[]
  attachments           CommercialInquiryAttachment[]
  containerShipmentGroups ContainerShipmentGroup[]
  containerStudies        ContainerStudy[]
  shipmentCostSnapshots   ShipmentCostSnapshot[]
  financialOfferSnapshots FinancialOfferSnapshot[]
  serviceCases            CustomerServiceCase[]
  supportChatSessions     SupportChatSession[]

  @@index([customerId])
  @@index([customerMasterId])
  @@index([status])
  @@index([inquiryDate])
  @@index([inquiryGroupKey])
  @@index([isCurrent])
  @@index([customerReference])
}

model CommercialInquiryAttachment {
  id         String            @id @default(cuid())
  inquiryId  String
  inquiry    CommercialInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  byteSize   Int
  content    Bytes
  uploadedBy String?
  createdAt  DateTime          @default(now())

  @@index([inquiryId])
}

model CableMasterAttachment {
  id             String      @id @default(cuid())
  materialNumber String
  cable          CableMaster @relation(fields: [materialNumber], references: [materialNumber], onDelete: Cascade)
  kind           String
  fileName       String
  mimeType       String
  byteSize       Int
  content        Bytes
  source         String      @default("MANUAL_UPLOAD")
  uploadedBy     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  inquiryLineCopies CommercialInquiryLineAttachment[]

  @@unique([materialNumber, kind])
  @@index([materialNumber])
}

model CommercialInquiryLineAttachment {
  id                      String               @id @default(cuid())
  inquiryLineId           String
  inquiryLine             CommercialInquiryLine @relation(fields: [inquiryLineId], references: [id], onDelete: Cascade)
  kind                    String
  fileName                String
  mimeType                String
  byteSize                Int
  content                 Bytes
  source                  String               @default("MANUAL_UPLOAD")
  cableMasterAttachmentId String?
  cableMasterAttachment   CableMasterAttachment? @relation(fields: [cableMasterAttachmentId], references: [id], onDelete: SetNull)
  uploadedBy              String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  @@index([inquiryLineId])
  @@index([inquiryLineId, kind])
}

model CommercialInquiryLine {
  id                      String            @id @default(cuid())
  inquiryId               String
  inquiry                 CommercialInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  lineNumber              Int               @default(1)

  // Cable Master Link or Unmapped Configuration
  materialNumber          String?
  customerCode            String?
  itemCode                String?
  cableDescription        String

  // Requested Quantities
  requestedQuantity       Decimal           @default(1)
  quantityUom             String            @default("KM")
  requestedLengthMeters   Decimal           @default(1000)
  cuttingLengthMeters     Decimal?
  drumType                String?           @default("Wood Reel 220")
  /** Order-level cable length tolerance (%) for production / logistics. */
  cableTolerancePercent   Decimal?
  /** Multi-drum schedule rows with per-drum tolerance (%). */
  drumSchedule            Json?

  // Technical Office & Governance
  configurationPayload    Json?
  cableAuthorityStatus    String            @default("CONFIGURATION_REQUIRED")
  technicalOfficeRequestId String?

  // Costing & Feasibility Link
  costingReadinessStatus  String            @default("NOT_READY")
  costingRunId            String?
  costingCalculationId    String?
  costingCalculation      CostingCalculation? @relation(fields: [costingCalculationId], references: [id], onDelete: SetNull)
  materialCost            Decimal?
  materialCostCurrency    String?           @default("USD")

  status                  InquiryLineStatus @default(DRAFT)
  notes                   String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  quotationLines          CommercialQuotationLine[]
  financialOfferProductLines FinancialOfferProductLine[]
  attachments             CommercialInquiryLineAttachment[]
  v2CurrentSnapshotId     String?
  v2CurrentCuttingPlanId  String?
  v2CurrentDrumPlanId     String?
  v2Snapshots             V2ConfigurationSnapshot[]
  v2CuttingRequirements   V2CuttingLengthRequirement[]
  v2CuttingPlans          V2CuttingLengthPlan[]
  v2DrumPlans             V2DrumPlan[]
  containerShipmentGroups ContainerShipmentGroup[]
  containerShipmentGroupMembers ContainerShipmentGroupLine[]
  serviceCases                  CustomerServiceCase[]

  @@index([inquiryId])
  @@index([materialNumber])
  @@index([status])
  @@index([v2CurrentSnapshotId])
  @@index([v2CurrentCuttingPlanId])
  @@index([v2CurrentDrumPlanId])
}

/// Immutable V2 cable configuration evidence linked to inquiry lines (Task 05B).
model V2ConfigurationSnapshot {
  id                         String                @id @default(cuid())
  snapshotId                 String                @unique
  versionNo                  Int                   @default(1)
  inquiryLineId              String
  inquiryLine                CommercialInquiryLine   @relation(fields: [inquiryLineId], references: [id], onDelete: Cascade)

  cableMaterialNumber        String?
  itemCode                   String?
  customerCode               String?

  selections                 Json
  configInput                Json
  validationStatus           String
  flowState                  String
  engineeringStatus          String
  summaryDescription         String?
  estimatedDiameterMm        Decimal?
  estimatedWeightKgKm        Decimal?
  catalogSource              String
  catalogAuthoritative       Boolean
  bomGovernanceBlocked       Boolean               @default(false)
  unresolvedBomConflictCount   Int                   @default(81)
  downstreamGates            Json?

  actorId                    String?
  actorEmail                 String?
  actorRole                  String?

  capturedAt                 DateTime              @default(now())
  createdAt                  DateTime              @default(now())

  cuttingRequirements        V2CuttingLengthRequirement[]
  cuttingPlans               V2CuttingLengthPlan[]
  costingCalculations        CostingCalculation[]

  @@index([inquiryLineId])
  @@index([inquiryLineId, versionNo])
  @@index([capturedAt])
}

/// Independent cutting-length requirement on a commercial inquiry line (05I-DRUM-REMEDIATION).
/// One CommercialInquiryLine may have 1..N requirements; they are never aggregated before drum planning.
model V2CuttingLengthRequirement {
  id                      String                     @id @default(cuid())
  requirementId           String                     @unique
  sequenceNo              Int

  inquiryLineId           String
  inquiryLine             CommercialInquiryLine      @relation(fields: [inquiryLineId], references: [id], onDelete: Cascade)

  configurationSnapshotId String
  configurationSnapshot   V2ConfigurationSnapshot    @relation(fields: [configurationSnapshotId], references: [id], onDelete: Restrict)

  unit                    String                     @default("M")
  nominalLengthM          Decimal
  toleranceMode           CuttingLengthToleranceMode @default(SYMMETRIC)
  positiveTolerancePercent Decimal                   @default(0)
  negativeTolerancePercent Decimal                   @default(0)
  minLengthM              Decimal
  maxLengthM              Decimal
  requestedDrumCount      Int                        @default(1)

  status                  String                     @default("ACTIVE")
  versionNo               Int                        @default(1)

  currentCuttingPlanId    String?
  currentDrumPlanId       String?

  actorId                 String?
  actorEmail              String?
  actorRole               String?

  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  cuttingPlans            V2CuttingLengthPlan[]      @relation("RequirementCuttingPlans")
  drumPlans               V2DrumPlan[]               @relation("RequirementDrumPlans")
  drumPlanLines           V2DrumPlanLine[]           @relation("RequirementDrumPlanLines")

  @@unique([inquiryLineId, sequenceNo])
  @@index([inquiryLineId])
  @@index([currentCuttingPlanId])
  @@index([currentDrumPlanId])
}

/// Immutable V2 cutting-length evidence linked to inquiry line + configuration snapshot (Task 05C).
model V2CuttingLengthPlan {
  id                              String                  @id @default(cuid())
  planId                          String                  @unique
  versionNo                       Int                     @default(1)

  inquiryLineId                   String
  inquiryLine                     CommercialInquiryLine   @relation(fields: [inquiryLineId], references: [id], onDelete: Cascade)

  cuttingLengthRequirementId      String?
  cuttingLengthRequirement        V2CuttingLengthRequirement? @relation("RequirementCuttingPlans", fields: [cuttingLengthRequirementId], references: [id], onDelete: SetNull)

  configurationSnapshotId         String
  configurationSnapshot           V2ConfigurationSnapshot @relation(fields: [configurationSnapshotId], references: [id], onDelete: Restrict)
  configurationSnapshotVersionNo  Int
  configurationSnapshotIdString   String

  nominalLengthM                  Decimal
  tolerancePercent                Decimal                 @default(1)
  toleranceMode                   CuttingLengthToleranceMode @default(SYMMETRIC)
  positiveTolerancePercent        Decimal                 @default(0)
  negativeTolerancePercent        Decimal                 @default(0)
  requestedDrumCount              Int                     @default(1)
  minLengthM                      Decimal
  maxLengthM                      Decimal

  validationStatus                String
  validationMessages              Json?

  notes                           String?

  actorId                         String?
  actorEmail                      String?
  actorRole                       String?

  capturedAt                      DateTime                @default(now())
  createdAt                       DateTime                @default(now())

  drumPlans                       V2DrumPlan[]
  costingCalculations             CostingCalculation[]

  @@index([inquiryLineId])
  @@index([inquiryLineId, versionNo])
  @@index([configurationSnapshotId])
  @@index([cuttingLengthRequirementId])
  @@index([capturedAt])
}

/// Authoritative V2 drum packaging plan linked to cutting plan (Task 05D).
model V2DrumPlan {
  id                              String                  @id @default(cuid())
  planId                          String                  @unique
  versionNo                       Int                     @default(1)

  inquiryLineId                   String
  inquiryLine                     CommercialInquiryLine   @relation(fields: [inquiryLineId], references: [id], onDelete: Cascade)

  cuttingLengthRequirementId      String?
  cuttingLengthRequirement        V2CuttingLengthRequirement? @relation("RequirementDrumPlans", fields: [cuttingLengthRequirementId], references: [id], onDelete: SetNull)

  cuttingLengthPlanId             String
  cuttingLengthPlan               V2CuttingLengthPlan     @relation(fields: [cuttingLengthPlanId], references: [id], onDelete: Restrict)
  cuttingLengthPlanVersionNo      Int
  cuttingLengthPlanIdString       String

  configurationSnapshotId         String
  configurationSnapshotIdString   String

  lifecycleStatus                 String
  validationStatus                String
  selectionMethod                 String

  cableTolerancePercent           Decimal
  totalPlannedLengthM             Decimal
  drumCount                       Int
  remainderLengthM                Decimal                 @default(0)
  quantityReconciliationStatus    String?
  quantityReconciliationMessages  Json?

  engineeringSnapshot             Json?

  notes                           String?
  actorId                         String?
  actorEmail                      String?
  actorRole                       String?

  capturedAt                      DateTime                @default(now())
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt

  lines                           V2DrumPlanLine[]
  costingCalculations             CostingCalculation[]
  costingRuns                     CostingRun[]

  @@index([inquiryLineId])
  @@index([inquiryLineId, versionNo])
  @@index([cuttingLengthPlanId])
  @@index([cuttingLengthRequirementId])
  @@index([lifecycleStatus])
  @@index([capturedAt])
}

model V2DrumPlanLine {
  id                       String     @id @default(cuid())
  drumPlanId               String
  drumPlan                 V2DrumPlan @relation(fields: [drumPlanId], references: [id], onDelete: Cascade)
  lineNo                   Int

  cuttingLengthRequirementId String?
