# ==============================================================================
# ENERGYA CONNECT — PRODUCTION / FREE TEST ENVIRONMENT TEMPLATE
# Platform: Render Free Web Service + Neon Serverless PostgreSQL
# ==============================================================================
# NEVER commit real secrets or credentials to source control.
# Copy and fill these values in the hosting dashboard (e.g. Render Environment tab).
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (Injected automatically by Render/Railway; default 3847 if omitted)
# PORT=10000

# PostgreSQL Connection String (Neon Serverless PostgreSQL)
# Use the pooled or direct connection string with sslmode=require and connect_timeout=15:
# Example: postgresql://[user]:[password]@[neon-endpoint].neon.tech/[dbname]?sslmode=require&connect_timeout=15
DATABASE_URL=

# Cryptographic Secret for JWT Signing (Minimum 32 characters)
# Render can auto-generate this via `generateValue: true` or generate manually using:
# openssl rand -base64 32
JWT_SECRET=

# Demo personas flag (Enables built-in demo credentials for testing and evaluation)
# Allowed values: "true" | "false"
ALLOW_DEMO_USERS=true

# Optional: CORS Allowed Origins (comma-separated if serving API to separate frontend domain)
# CORS_ALLOWED_ORIGINS=

# Recommended attachment limits:
# To stay well within free tier limits (Neon 512MB storage), keep uploads <= 5MB.
