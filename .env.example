# ==============================================================================
# ENERGYA CONNECT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env locally or inject via the hosting secrets manager.
# NEVER commit real secrets.
# ==============================================================================

# --- Development defaults (local only) ---
# NODE_ENV=development
# DATABASE_URL="postgresql://energya:energya_dev@127.0.0.1:5432/energya_connect?schema=public"
# JWT_SECRET="energya_connect_dotnet9_super_secret_jwt_key_2026_x89f!"
# ADMIN_SEED_PASSWORD="Admin@2026!"
# PORT=3847
# LOGIN_LOCK_THRESHOLD=5

# --- Production / public demo (required) ---
NODE_ENV=production

# Platform-injected PORT must be respected (Railway/Render/etc.). Do not hardcode when $PORT is set.
PORT=3847

# PostgreSQL connection (managed demo DB)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://energya_demo_user:ReplaceWithStrongDbPassword_2026@postgres-host:5432/energya_connect?schema=public

# Cryptographic secret for JWT signing (REQUIRED in production).
# Must NOT equal the development fallback. Minimum 32 characters.
# Generate: openssl rand -base64 32
JWT_SECRET=ReplaceWithSecureRandomSecretKeyOfAtLeast32BytesLength_2026_x92!

# Administrator seed password (REQUIRED when NODE_ENV=production during prisma seed).
# Must be set explicitly. Default demo passwords (e.g. Admin@2026!) are REJECTED in production.
ADMIN_SEED_PASSWORD=ReplaceWithDemoAdminPassword_2026!

# Optional: seed documented demo personas (sales/tech/costing/customer) on production/demo hosts.
# Requires explicit opt-in. Prefer setting DEMO_*_PASSWORD; documented fallbacks apply only when flagged.
# ALLOW_DEMO_USERS=true
# DEMO_SEED=true
# DEMO_RESET_PASSWORDS=false
# DEMO_CUSTOMER_PASSWORD=Customer@2026!
# DEMO_SALES_PASSWORD=Sales@2026!
# DEMO_TECH_PASSWORD=Tech@2026!
# DEMO_COSTING_PASSWORD=Admin@2026!
# DEMO_PROCUREMENT_PASSWORD=Admin@2026!

# Security policies — production overrides force these off even if mis-set to true
LOGIN_LOCK_THRESHOLD=5
ALLOW_DEV_IDENTITY_SEED=false
ADMIN_RESET_TOKEN_IN_RESPONSE=false

# Optional CORS (same-origin monolith usually needs none)
CORS_ALLOWED_ORIGINS=https://demo.energyaconnect.com

# V2 quotation default validity (calendar days from issue/create)
# V2_QUOTATION_VALIDITY_DAYS=30

# Optional: Gemini AI assistant
# GEMINI_API_KEY=

# Optional: SMTP notifications
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM=notifications@energyaconnect.com
# NOTIFY_SALES_EMAIL=sales@energya.com
