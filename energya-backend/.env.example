# Names only. Do not put values or secrets in this file.
# Copy to energya-backend/.env and set values locally.

# Required. PostgreSQL connection string.
DATABASE_URL

# Required. At least 32 characters. Must not be the default rejected by AuthModule.
JWT_SECRET

# Optional. Nest listen port. Code default is 3000.
PORT

# Optional. development or production.
NODE_ENV

# Optional. Used by main.ts when CORS_ALLOWED_ORIGINS is empty.
CORS_ORIGIN

# Optional. Comma-separated browser origins.
CORS_ALLOWED_ORIGINS

# Optional. true or false. Production defaults to enabled when unset.
LOGIN_RATE_LIMIT

# Optional. Login throttle max. Code default is 20.
LOGIN_RATE_MAX

# Optional. Login throttle window in milliseconds. Code default is 60000.
LOGIN_RATE_WINDOW_MS

# Optional. Failed logins before lock. Code default is 5.
LOGIN_LOCK_THRESHOLD

# Optional. true returns a reset token outside production.
ADMIN_RESET_TOKEN_IN_RESPONSE
